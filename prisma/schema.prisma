// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum UserState {
  CHOOSING_LANGUAGE
  BROWSING
  CHOOSING_QUANTITY
  ADDING_PRODUCT_NAME
  ADDING_PRODUCT_PRICE
  ENTERING_ADDRESS
  ENTERING_SHOP_NAME
}

model User {
  id                 Int          @id @default(autoincrement())
  phone              String       @unique
  name               String?
  role               Role         @default(CUSTOMER)
  language           String       @default("en")
  state              UserState    @default(CHOOSING_LANGUAGE)
  pendingProductId   Int?
  pendingProductName String?
  address            String?
  shopName           String?
  sellerStatus       SellerStatus @default(NONE)
  createdAt          DateTime     @default(now())
  products           Product[]
  orders             Order[]      @relation("CustomerOrders")
  soldItems          OrderItem[]  @relation("SellerOrderItems")
  cart               Cart?
}

model Product {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Decimal              @db.Decimal(10, 2)
  sellerId     Int
  seller       User                 @relation(fields: [sellerId], references: [id])
  translations ProductTranslation[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  isActive     Boolean              @default(true)
  stock        Int?
  createdAt    DateTime             @default(now())
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   Int
  language    String
  name        String
  description String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(10, 2)
  deliveryAddress String?
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  sellerId  Int
  seller    User        @relation("SellerOrderItems", fields: [sellerId], references: [id])
  quantity  Int
  unitPrice Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
}

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @unique
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int
  order      Order         @relation(fields: [orderId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(COD)
  status     PaymentStatus @default(INITIATED)
  gatewayRef String?       @unique
  createdAt  DateTime      @default(now())
}

model ProcessedMessage {
  id        String   @id
  createdAt DateTime @default(now())
}