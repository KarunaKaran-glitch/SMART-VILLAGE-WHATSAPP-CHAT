// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
  AWAITING_CONFIRMATION
}

enum PaymentMethod {
  COD
  ONLINE
  UPI_DIRECT
}

enum UserState {
  CHOOSING_LANGUAGE
  BROWSING
  CHOOSING_QUANTITY
  ADDING_PRODUCT_NAME
  ADDING_PRODUCT_PRICE
  ENTERING_ADDRESS
  ENTERING_SHOP_NAME
  CHOOSING_PAYMENT
  ADDING_PRODUCT_PHOTO
  SETTING_UPI_QR
  CHOOSING_CATEGORY
  ADDING_PRODUCT_DESCRIPTION
}

// Every product is checked by an admin (handmade products only) before customers see it.
// DRAFT: the seller is still adding products; they go to PENDING when the seller taps
// "Send all to admin", so the admin gets one message for the whole batch.
enum ProductApproval {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

// Product groups the customer chooses first (Keychains, Handbags, Wallets ...).
// A seller makes one kind of product, so the category belongs to the seller and
// every new product of that seller gets it.
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique // English name, also used when no translation exists
  names     Json? // translations, for example { "hi": "चाबी के छल्ले" }
  sellers   User[]
  products  Product[]
  createdAt DateTime  @default(now())
}

model User {
  id                 Int          @id @default(autoincrement())
  phone              String       @unique
  name               String?
  role               Role         @default(CUSTOMER)
  language           String       @default("en")
  state              UserState    @default(CHOOSING_LANGUAGE)
  pendingProductId   Int?
  pendingProductName String?
  address            String?
  shopName           String?
  upiId              String?
  upiQrKey           String? // Image.key of the seller's UPI QR code photo
  sellerStatus       SellerStatus @default(NONE)
  categoryId         Int? // the kind of product this seller makes
  category           Category?    @relation(fields: [categoryId], references: [id])
  // Seller's own link: customers send "Hi <shopCode>" and see only this seller's shop
  shopCode           String?      @unique
  // Local language of the seller's state (hi, or, as), offered first, then Hindi and English
  // (en = English only, an older choice)
  shopLanguage       String?
  // The seller's state (Assam, Himachal Pradesh, Madhya Pradesh, Odisha, Rajasthan), set by the admin
  sellerState        String?
  // Customer: the seller whose link they came from
  shopId             Int?
  shop               User?        @relation("ShopCustomers", fields: [shopId], references: [id])
  shopCustomers      User[]       @relation("ShopCustomers")
  // Customer's secret for the shop web page link (new one on every "Shop now", valid 24 hours)
  webToken           String?      @unique
  webTokenAt         DateTime?
  // Seller's or admin's secret for their dashboard page link (valid 24 hours)
  dashToken          String?      @unique
  dashTokenAt        DateTime?
  createdAt          DateTime     @default(now())
  products           Product[]
  orders             Order[]      @relation("CustomerOrders")
  soldItems          OrderItem[]  @relation("SellerOrderItems")
  cart               Cart?
}

model Product {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Decimal              @db.Decimal(10, 2)
  sellerId     Int
  seller       User                 @relation(fields: [sellerId], references: [id])
  translations ProductTranslation[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  isActive     Boolean              @default(true)
  stock        Int?
  imageKey     String? // Image.key of the product photo
  thumbKey     String? // Image.key of a small copy (about 400 px) for grids and lists; null = use imageKey
  description  String? // short text from the seller: colour, size, material ...
  approval     ProductApproval      @default(PENDING)
  categoryId   Int?
  category     Category?            @relation(fields: [categoryId], references: [id])
  createdAt    DateTime             @default(now())
}

// Photos (product photos, seller QR codes, generated QR codes), served at /images/<key>
model Image {
  id        Int      @id @default(autoincrement())
  key       String   @unique // random, so image links cannot be guessed
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   Int
  language    String
  name        String
  description String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  total           Decimal     @db.Decimal(10, 2)
  deliveryAddress String?
  deliveredAt     DateTime? // when the seller marked it delivered (shown on the thank-you page)
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  sellerId  Int
  seller    User        @relation("SellerOrderItems", fields: [sellerId], references: [id])
  quantity  Int
  unitPrice Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
}

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @unique
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Payment {
  id         Int           @id @default(autoincrement())
  orderId    Int
  order      Order         @relation(fields: [orderId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(COD)
  status     PaymentStatus @default(INITIATED)
  gatewayRef String?       @unique
  reference  String?       @unique // customer's UPI transaction number (sent with PAID)
  createdAt  DateTime      @default(now())
}

model ProcessedMessage {
  id        String   @id
  createdAt DateTime @default(now())
}